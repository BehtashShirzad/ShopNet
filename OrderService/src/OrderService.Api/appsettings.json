{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OrderOutbox": { "DeliveryEnabled": false },
  "Inventory": { "ReservationMinutes": 15, "CommandQueue": "inventory-commands-v1" },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/shopnet",
    "MetadataAddress": "http://localhost:8080/realms/shopnet/.well-known/openid-configuration",
    "Audience": "shopnet-api",
    "RequireHttpsMetadata": false
  }
}
